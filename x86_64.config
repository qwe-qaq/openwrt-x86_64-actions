# ============================================================================
# 复刻官方固件：openwrt-25.12.6-x86-64-generic-ext4-combined-efi.img.gz
# 目标：这个镜像里预装的包全部选上 + 中文选项
# 部署环境：华为云 ECS / KVM VPS（见 HUAWEICLOUD.md）
# 源码：https://github.com/openwrt/openwrt  （Run workflow 默认 v25.12.6）
#
# 包集依据（见 OFFICIAL_IMAGE_PACKAGES.md）：
#   1) 官方 profiles.json 的 target 默认包 29 个 + generic 设备包 14 个 = 43 个
#   2) 25.12 官方 release 镜像标配的 LuCI 套件
#   3) 镜像 manifest 里的公共依赖库（构建系统会自动带入，这里也显式写 =y）
# 中文：CONFIG_LUCI_LANG_zh_Hans + luci-i18n-*-zh-cn 语言包
#
# 说明：manifest 是纯文本文件，本次未能直接读取原文；依赖类包名按 25.12
#       官方 APK 包目录与 25.12.6 构建产物核对。写进来的包若当前分支不存在，
#       make defconfig 会静默丢弃，diy-part2.sh 会打印核对结果。
#
# ▼ 云 VPS 场景的三个适配点（不在 .config 里，由其他文件完成）
#   1) 默认网络：官方 br-lan 静态 192.168.1.1 + 开 DHCP 服务器 → 云上必失联
#      huaweicloud/99-cloud-init.sh 在首次启动改成 eth0 + DHCP 客户端并关 DHCP 服务
#   2) 登录凭据：官方 root 空密码 + 无 Cloud-Init，控制台注入的密码不生效
#      workflow 的 root_password 输入 / huaweicloud/authorized_keys 注入
#   3) 镜像格式：.img.gz 解压是 RAW，IMS 导入时按启动方式选 BIOS 或 UEFI
# ============================================================================

# ---------------------------------------------------------------- 目标与镜像
# 同时产出 BIOS(combined) 与 UEFI(combined-efi) 两份 ext4 镜像：
# 华为云 IMS 注册私有镜像时必须选对启动方式，两种都留着最保险
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_EFI_IMAGES=y
# 串口控制台 115200：华为云 VNC / 串口控制台能看到 GRUB 与启动日志，排障必备
CONFIG_GRUB_CONSOLE=y
CONFIG_GRUB_BAUDRATE=115200
CONFIG_GRUB_TIMEOUT="3"
CONFIG_GRUB_TITLE="OpenWrt"
CONFIG_PACKAGE_grub2-efi=y

# ---------------------------------------------------------------- VirtIO 说明
# 不要写 CONFIG_PACKAGE_kmod-virtio-net=y：
#   virtual.mk 里这个包 DEPENDS:=@TARGET_x86_kvm_guest，在 x86/64 generic 目标上
#   选不中，写了只会被 defconfig 静默丢弃（正是我们一直在提醒的那个坑）。
#   官方 x86/64 内核本身已内建 virtio_net / virtio_blk / virtio_pci / virtio_console，
#   这是 x86 目标与 armvirt 的已知差异。若实测确实缺驱动，见 HUAWEICLOUD.md 的应急段。

# ============================================================================
# 一、中文选项（本次新增）
# ============================================================================
# LuCI 界面默认语言设为简体中文
CONFIG_LUCI_LANG_zh_Hans=y
# 基础界面 / 防火墙 / 软件包 / 在线升级 的中文翻译
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-attendedsysupgrade-zh-cn=y
# 可选：其他 LuCI 模块的中文包（镜像里装了对应应用时可解开）
# CONFIG_PACKAGE_luci-i18n-uhttpd-zh-cn=y
# CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y

# ============================================================================
# 二、官方 release 镜像标配的 LuCI / Web 套件
# ============================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_cgi-io=y

# ============================================================================
# 三、官方 profiles.json：Target default packages（29 个）
# ============================================================================
CONFIG_PACKAGE_apk-mbedtls=y
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_grub2-bios-setup=y
CONFIG_PACKAGE_kmod-button-hotplug=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libustream-mbedtls=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_partx-utils=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

# ============================================================================
# 四、官方 profiles.json：Generic x86/64 Device packages（14 个）
# ============================================================================
CONFIG_PACKAGE_kmod-amazon-ena=y
CONFIG_PACKAGE_kmod-amd-xgbe=y
CONFIG_PACKAGE_kmod-bnx2=y
CONFIG_PACKAGE_kmod-dwmac-intel=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-forcedeth=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-tg3=y
CONFIG_PACKAGE_kmod-drm-i915=y

# ============================================================================
