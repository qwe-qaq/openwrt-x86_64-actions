# ============================================================================
# OpenWrt 官方源码 x86/64 —— 官方 feeds 插件配置
# 适用分支：openwrt-25.12（默认）/ openwrt-24.10 / main
# 用法：直接替换仓库根目录的 x86_64.config，工作流无需改动
#
# 重要：本文件只写「官方 packages / luci / routing / telephony feeds 里确实存在」
#       的包。第三方插件（OpenClash / SSR+ / PassWall / iStore / Argon 主题等）
#       官方没有，写进来也会被 make defconfig 静默丢弃，编译日志不会报错。
#       编译前 diy-part2.sh 会打印「被丢弃的包」，请务必看一眼那段日志。
# ============================================================================

# ---------------------------------------------------------------- 目标与镜像
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
# profile / device 符号由 make defconfig 按当前分支自动补全
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_EFI_IMAGES=y

# ---------------------------------------------------------------- LuCI 与中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-firewall=y
# 24.10/25.12 通用（替代旧 luci-app-opkg）
CONFIG_PACKAGE_luci-app-package-manager=y
# 25.12 起官方在线升级
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
# 25.12 专用；24.10 无此包会自动丢弃
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# ---------------------------------------------------------------- 网络功能
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
# 动态域名（官方版，非 ddns-go）
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_sqm-scripts=y
# 智能队列管理 / 抗缓冲膨胀
CONFIG_PACKAGE_luci-app-sqm=y
# UPnP，依赖自动带 miniupnpd
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_adblock=y
# DNS 去广告
CONFIG_PACKAGE_luci-app-adblock=y
CONFIG_PACKAGE_banip=y
# IP 黑名单
CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_https-dns-proxy=y
# DoH 代理
CONFIG_PACKAGE_luci-app-https-dns-proxy=y
CONFIG_PACKAGE_smartdns=y
# 官方源内的 SmartDNS
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_frpc=y
# FRP 内网穿透客户端
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_openvpn-openssl=y
# OpenVPN（需 kmod-tun，见下）
CONFIG_PACKAGE_luci-app-openvpn=y
# 25.12 有；24.10 无此包会自动丢弃
CONFIG_PACKAGE_luci-proto-wireguard=y

# ---------------------------------------------------------------- 监控统计
CONFIG_PACKAGE_collectd=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-rrdtool=y
CONFIG_PACKAGE_collectd-mod-ping=y
CONFIG_PACKAGE_collectd-mod-thermal=y
CONFIG_PACKAGE_collectd-mod-ethstat=y
# 历史图表（Statistics 菜单）
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_nlbwmon=y
# 按主机流量统计
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_vnstat2=y
# 流量日报
CONFIG_PACKAGE_luci-app-vnstat2=y

# ---------------------------------------------------------------- 管理工具
CONFIG_PACKAGE_ttyd=y
# 网页终端
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_etherwake=y
# 网络唤醒
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_watchcat=y
# 断网自动重启
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_irqbalance=y
# 多核中断均衡（软路由有用）
CONFIG_PACKAGE_luci-app-irqbalance=y
# 高级重启
CONFIG_PACKAGE_luci-app-advanced-reboot=y

# ---------------------------------------------------------------- 命令行工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_rsync=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_file=y
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_drill=y
CONFIG_PACKAGE_bind-tools=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y

# ---------------------------------------------------------------- 磁盘 / 文件系统
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_gdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y

# ---------------------------------------------------------------- x86 硬件驱动
# 官方 x86 镜像默认驱动很少，论坛官方 wiki 明确建议按需把驱动编进镜像
# Intel 有线：igb(千兆) / igc(2.5G) / e1000e
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-e1000e=y
# Realtek 千兆
CONFIG_PACKAGE_kmod-r8169=y
# VMware 虚拟网卡
CONFIG_PACKAGE_kmod-vmxnet3=y
# SATA/AHCI（注意不是 kmod-ahci）
CONFIG_PACKAGE_kmod-ata-ahci=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
# USB 2.5G 网卡（RTL8156 常用）
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
# USB 千兆网卡
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
# 官方只有老 ntfs，没有 ntfs3
CONFIG_PACKAGE_kmod-fs-ntfs=y
# VPN / 隧道需要
CONFIG_PACKAGE_kmod-tun=y

# ---------------------------------------------------------------- 可选（按需解开）
# 万兆 / 虚拟化 / 其他驱动：
# CONFIG_PACKAGE_kmod-ixgbe=y
# CONFIG_PACKAGE_kmod-i40e=y
# CONFIG_PACKAGE_kmod-virtio-net=y
# CONFIG_PACKAGE_kmod-usb2=y
#
# 官方源里有、但体积大或依赖重的插件：
# CONFIG_PACKAGE_v2raya=y
# CONFIG_PACKAGE_luci-app-v2raya=y
# CONFIG_PACKAGE_luci-app-adguardhome=y          # 仅 25.12
# CONFIG_PACKAGE_tailscale=y
# CONFIG_PACKAGE_luci-app-tailscale-community=y  # 仅 25.12
# CONFIG_PACKAGE_transmission-daemon=y
# CONFIG_PACKAGE_luci-app-transmission=y
# CONFIG_PACKAGE_samba4-server=y
# CONFIG_PACKAGE_luci-app-samba4=y
# CONFIG_PACKAGE_ksmbd-server=y
# CONFIG_PACKAGE_luci-app-ksmbd=y
# CONFIG_PACKAGE_dockerd=y
# CONFIG_PACKAGE_luci-app-dockerman=y
# CONFIG_PACKAGE_luci-app-filebrowser=y
# CONFIG_PACKAGE_luci-app-unbound=y
# CONFIG_PACKAGE_luci-app-mwan3=y
# CONFIG_PACKAGE_luci-app-pbr=y

# ---------------------------------------------------------------- 官方确实没有
# 以下都是第三方生态包，官方四个 feeds 里不存在，写进 .config 也会被丢弃：
#   luci-app-openclash / luci-app-passwall / luci-app-ssr-plus / luci-app-homeproxy
#   luci-app-istore / luci-app-quickstart / luci-app-diskman / luci-app-linkease
#   luci-app-ddns-go / luci-app-lucky / luci-app-mosdns / luci-theme-argon
# 想要它们：在 diy-part1.sh 里追加对应 src-git 源，再打开上面的 CONFIG_PACKAGE_xxx=y
# ============================================================================
